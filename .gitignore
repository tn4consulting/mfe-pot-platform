# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
www
# Stencil build cache and its regenerated loader/ output (both fully
# derived from src/ by `stencil build` -- see libs/shared/ui-scds-core)
libs/shared/*/.stencil
libs/shared/*/loader

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# Playwright
/test-results
/playwright-report
/blob-report
/playwright/.cache

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

.claude/worktrees
.claude/settings.local.json
.nx/polygraph
.nx/self-healing
.nx/migrate-runs
.angular

# Stale local cache from the retired Firebase Hosting setup (firebase.json
# and .firebaserc are already gone -- see CLAUDE.md's Hosting section).
.firebase

# Helm dependency archives -- packaged from this same repo's mfe-backend-lib
# via a local file:// path (see charts/mock-idp/Chart.yaml); commit would
# drift stale relative to the source, so regenerate on demand with `helm
# dependency update` instead. Same convention as every app repo's own
# charts/*/.gitignore entry for their own library-chart dependencies.
charts/*/charts/
charts/*/Chart.lock
