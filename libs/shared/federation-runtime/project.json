{
  "name": "shared-federation-runtime",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/federation-runtime/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["type:shared", "scope:shared"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/libs/shared/federation-runtime"],
      "options": {
        "project": "libs/shared/federation-runtime/ng-package.json",
        "tsConfig": "libs/shared/federation-runtime/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/shared/federation-runtime/jest.config.cts",
        "tsConfig": "libs/shared/federation-runtime/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
