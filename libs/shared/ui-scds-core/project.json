{
  "name": "shared-ui-scds-core",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/ui-scds-core/src",
  "projectType": "library",
  "tags": ["type:shared", "scope:shared"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist", "{projectRoot}/loader"],
      "options": {
        "command": "stencil build",
        "cwd": "libs/shared/ui-scds-core"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "dependsOn": ["build"],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/shared/ui-scds-core/jest.config.cts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["libs/shared/ui-scds-core/src/**/*.{ts,tsx}"]
      }
    }
  }
}
