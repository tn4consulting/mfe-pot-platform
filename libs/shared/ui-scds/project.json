{
  "name": "shared-ui-scds",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/ui-scds/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["type:shared", "scope:shared"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/libs/shared/ui-scds"],
      "options": {
        "project": "libs/shared/ui-scds/ng-package.json",
        "tsConfig": "libs/shared/ui-scds/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/shared/ui-scds/jest.config.cts",
        "tsConfig": "libs/shared/ui-scds/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["libs/shared/ui-scds/src/**/*.ts", "!libs/shared/ui-scds/src/lib/stencil-generated/**"]
      }
    }
  }
}
