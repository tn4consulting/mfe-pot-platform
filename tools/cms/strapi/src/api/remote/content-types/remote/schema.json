{
  "kind": "collectionType",
  "collectionName": "remotes",
  "info": {
    "singularName": "remote",
    "pluralName": "remotes",
    "displayName": "Remote",
    "description": "Federation directory entry: which URL a named MFE remote is currently served from."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "url": {
      "type": "string",
      "required": true
    },
    "routePrefix": {
      "type": "string",
      "required": true
    },
    "version": {
      "type": "string",
      "required": true,
      "default": "0.0.0"
    }
  }
}
