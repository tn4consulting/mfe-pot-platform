{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "paths": {
      "@tn4consulting/shared-remote-registry": [
        "./libs/shared/remote-registry/src/index.ts"
      ],
      "@tn4consulting/shared-content-client": [
        "./libs/shared/content-client/src/index.ts"
      ],
      "@tn4consulting/shared-i18n": ["./libs/shared/i18n/src/index.ts"],
      "@tn4consulting/shared-federation-runtime": [
        "./libs/shared/federation-runtime/src/index.ts"
      ],
      "@tn4consulting/shared-auth": ["./libs/shared/auth/src/index.ts"],
      "@tn4consulting/shared-auth/core": ["./libs/shared/auth/src/core.ts"],
      "@tn4consulting/shared-runtime-config": ["./libs/shared/runtime-config/src/index.ts"],
      "@tn4consulting/shared-session-cache": ["./libs/shared/session-cache/src/index.ts"],
      "@tn4consulting/shared-auth-server": ["./libs/shared/auth-server/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
